meta {
  name: Register
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "{{registerName}}",
    "email": "{{registerEmail}}",
    "password": "{{registerPassword}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("jwt", res.getBody().token);
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
